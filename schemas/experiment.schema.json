{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proofforge.local/schemas/experiment.schema.json",
  "title": "TrenGuard experiment configuration",
  "type": "object",
  "required": ["id", "name", "seed", "baseUrl", "scenarios", "mutations", "repetitions", "runner", "artifactDir", "failOnInconclusive"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "seed": { "type": "string", "minLength": 1 },
    "baseUrl": { "type": "string", "format": "uri" },
    "scenarios": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "mutations": { "type": "array", "items": { "enum": ["M1", "M2", "M3", "M4", "M5", "M6"] } },
    "repetitions": { "type": "integer", "minimum": 1 },
    "runner": { "enum": ["playwright", "e2e"] },
    "artifactDir": { "type": "string", "minLength": 1 },
    "failOnInconclusive": { "type": "boolean" }
  }
}
