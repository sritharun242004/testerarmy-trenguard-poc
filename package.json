{
  "name": "proofforge",
  "version": "0.1.0",
  "private": true,
  "description": "TrenGuard Phase 1 checkout verification demo",
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/server.ts",
    "start": "node dist/server.js",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:mutation:m1": "playwright test --config=playwright.mutation.config.ts",
    "test:e2e:optional": "e2e run --config testerarmy.e2e.config.ts --no-cache",
    "test:unit": "node --import tsx --test tests/unit/*.test.ts",
    "proofforge": "tsx scripts/proofforge.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "pnpm typecheck && pnpm build && pnpm test:unit && pnpm test && pnpm test:mutation:m1",
    "benchmark": "pnpm proofforge run --config proofforge.config.ts"
  },
  "devDependencies": {
    "@e2e-dev/web": "0.15.2",
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.8.1",
    "e2e": "0.21.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
